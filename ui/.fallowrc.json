{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/v3.33.1/schema.json",
  // The pages that scripts/build-ui.sh builds, the script that lists them in the manifest, and the
  // oxlint rule that .oxlintrc.json loads.
  "entry": [
    "src/login.ts",
    "src/setup.ts",
    "src/account.ts",
    "styles/app.css",
    "scripts/manifest.ts",
    "lint/no-unsound-cast.js"
  ],
  // A page imports only webauthn.ts, password.ts, totp.ts and the generated contract.ts, never
  // another page.
  "boundaries": {
    "zones": [
      { "name": "pages", "patterns": ["src/login.ts", "src/setup.ts", "src/account.ts"] },
      { "name": "webauthn", "patterns": ["src/webauthn.ts"] },
      { "name": "password", "patterns": ["src/password.ts"] },
      { "name": "totp", "patterns": ["src/totp.ts"] },
      { "name": "contract", "patterns": ["src/contract.ts"] }
    ],
    "rules": [
      { "from": "pages", "allow": ["webauthn", "password", "totp", "contract"] },
      { "from": "webauthn", "allow": ["contract"] },
      { "from": "password", "allow": [] },
      { "from": "totp", "allow": ["contract"] },
      { "from": "contract", "allow": [] }
    ],
    "coverage": {
      "requireAllFiles": true,
      "allowUnmatched": ["styles/**", "scripts/**", "lint/**"]
    }
  },
  "audit": { "deadCodeBaseline": "fallow-baseline.json" },
  "rules": { "policy-violation": "off" }
}
