{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/v3.33.1/schema.json",
  // The pages that scripts/build-ui.sh builds.
  "entry": ["src/login.ts", "src/setup.ts", "src/account.ts", "styles/app.css"],
  // A page imports only webauthn.ts, password.ts and the generated contract.ts, never another page.
  "boundaries": {
    "zones": [
      { "name": "pages", "patterns": ["src/login.ts", "src/setup.ts", "src/account.ts"] },
      { "name": "webauthn", "patterns": ["src/webauthn.ts"] },
      { "name": "password", "patterns": ["src/password.ts"] },
      { "name": "contract", "patterns": ["src/contract.ts"] }
    ],
    "rules": [
      { "from": "pages", "allow": ["webauthn", "password", "contract"] },
      { "from": "webauthn", "allow": ["contract"] },
      { "from": "password", "allow": [] },
      { "from": "contract", "allow": [] }
    ],
    "coverage": { "requireAllFiles": true, "allowUnmatched": ["styles/**", "scripts/**"] }
  },
  "audit": { "deadCodeBaseline": "fallow-baseline.json" },
  "rules": { "policy-violation": "off" }
}
