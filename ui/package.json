{
  "name": "zeabur-identity-ui",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun scripts/gen-classes.ts && tailwindcss --input styles/app.css --output dist/app.css --minify",
    "typecheck": "tsc -b",
