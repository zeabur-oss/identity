    "fmt:check": "oxfmt --check"
  },
  "dependencies": {
    "@zeabur-oss/design-system": "0.1.4"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.3.5",
    "@types/bun": "1.4.4",
    "class-variance-authority": "0.7.1",
    "cn": "0.5.2",
    "oxfmt": "0.77.0",
    "oxlint": "1.92.0",
    "tailwindcss": "4.3.5",
    "typescript": "7.0.2"
  }
}
