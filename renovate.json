{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Cargo crates, ui/ packages (bun.lock, the same schedule and grouping as Zeabur's web/), action digests and the k3s test version, on the shared zeabur-oss preset. Lock file maintenance also updates flake.lock, and with it the Rust nightly.",
  "extends": [
    "github>zeabur-oss/.github"
  ],
  "enabledManagers": [
    "cargo",
    "bun",
    "github-actions",
    "nix",
    "custom.regex"
  ],
  "packageRules": [
    {
      "description": "One pull request for compatible crate updates; majors stay separate.",
      "matchManagers": [
        "cargo"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "cargo (non-major)"
    },
    {
      "description": "One pull request for compatible ui/ package updates; majors stay separate.",
      "matchManagers": [
        "bun"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "ui (non-major)"
    },
    {
      "description": "The test image and the documented release move together.",
      "matchPackageNames": [
        "rancher/k3s",
        "k3s-io/k3s"
      ],
      "groupName": "k3s"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "k3s image used by the cluster tests (scripts/ci.sh, scripts/k3d-up.sh, CONTRIBUTING.md).",
      "managerFilePatterns": [
        "/^scripts/ci\\.sh$/",
        "/^scripts/k3d-up\\.sh$/",
        "/^CONTRIBUTING\\.md$/"
      ],
      "matchStrings": [
        "rancher/k3s:(?<currentValue>v[0-9.]+-k3s[0-9]+)"
      ],
      "depNameTemplate": "rancher/k3s",
      "datasourceTemplate": "docker",
      "versioningTemplate": "regex:^v(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)-k3s(?<build>\\d+)$"
    },
    {
      "customType": "regex",
      "description": "k3s release in the install guide.",
      "managerFilePatterns": [
        "/^docs/get-started\\.md$/"
      ],
      "matchStrings": [
        "INSTALL_K3S_VERSION=(?<currentValue>v[0-9.]+\\+k3s[0-9]+)"
      ],
      "depNameTemplate": "k3s-io/k3s",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "regex:^v(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)\\+k3s(?<build>\\d+)$"
    }
  ]
}
