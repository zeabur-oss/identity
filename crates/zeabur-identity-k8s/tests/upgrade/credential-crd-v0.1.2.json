{
  "apiVersion": "apiextensions.k8s.io/v1",
  "kind": "CustomResourceDefinition",
  "metadata": {
    "name": "credentials.identity.zeabur.com"
  },
  "spec": {
    "group": "identity.zeabur.com",
    "names": {
      "categories": [
        "zeabur-identity"
      ],
      "kind": "Credential",
      "plural": "credentials",
      "shortNames": [
        "zbcred"
      ],
      "singular": "credential"
    },
    "scope": "Namespaced",
    "versions": [
      {
        "additionalPrinterColumns": [
          {
            "jsonPath": ".spec.user",
            "name": "User",
            "type": "string"
          },
          {
            "jsonPath": ".spec.type",
            "name": "Type",
            "type": "string"
          },
          {
            "jsonPath": ".metadata.creationTimestamp",
            "name": "Age",
            "type": "date"
          }
        ],
        "name": "v1alpha1",
        "schema": {
          "openAPIV3Schema": {
            "description": "A passkey or linked upstream identity of a Zeabur Identity user.",
            "properties": {
              "spec": {
                "description": "A way for a `User` to sign in.\n\nThe object name is derived from the credential's unique key (`c-` + hex SHA-256 of the\npasskey credential ID, or of the upstream issuer and subject), so creating a duplicate fails\nwith `409 AlreadyExists`. That is the uniqueness check WebAuthn Level 3 §7.1 asks for, and\nit holds across replicas. The spec is immutable; revoking is deleting. `status` holds what\nthe user may change (the label) and when the credential was last used.",
                "properties": {
                  "external": {
                    "description": "Upstream identity, when `type` is `GitHub` or `Google`.",
                    "nullable": true,
                    "properties": {
                      "issuer": {
                        "description": "Upstream issuer.",
                        "maxLength": 256,
                        "minLength": 1,
                        "type": "string"
                      },
                      "subject": {
                        "description": "Upstream subject: the stable account ID, never an email address.",
                        "maxLength": 256,
                        "minLength": 1,
                        "type": "string"
                      }
                    },
                    "required": [
                      "issuer",
                      "subject"
                    ],
                    "type": "object"
                  },
                  "passkey": {
                    "description": "Passkey details, when `type` is `Passkey`.",
                    "nullable": true,
                    "properties": {
                      "aaguid": {
                        "description": "Authenticator model (AAGUID), when the authenticator reports one.",
                        "nullable": true,
                        "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
                        "type": "string"
                      },
                      "backupEligible": {
                        "default": false,
                        "description": "Whether the credential may be synced to other devices (BE flag).",
                        "type": "boolean"
                      },
                      "credentialId": {
                        "description": "Credential ID, base64url.",
                        "maxLength": 1366,
                        "minLength": 1,
                        "pattern": "^[A-Za-z0-9_-]+$",
                        "type": "string"
                      },
                      "label": {
                        "description": "User-chosen label, for example \"MacBook\".",
                        "maxLength": 64,
                        "nullable": true,
                        "type": "string"
                      },
                      "record": {
                        "description": "The relying party's stored credential record, as serialized by the WebAuthn library\n(public key, algorithm, flags). Opaque to Kubernetes.",
                        "maxLength": 16384,
                        "minLength": 1,
                        "type": "string"
                      }
                    },
                    "required": [
                      "credentialId",
                      "record"
                    ],
                    "type": "object"
                  },
                  "type": {
                    "description": "Kind of credential.",
                    "enum": [
                      "Passkey",
                      "GitHub",
                      "Google"
                    ],
                    "type": "string"
                  },
                  "user": {
                    "description": "Name of the `User` object.",
                    "maxLength": 253,
                    "minLength": 1,
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "user"
                ],
                "type": "object",
                "x-kubernetes-validations": [
                  {
                    "message": "credentials are immutable; delete and re-enrol instead",
                    "rule": "self == oldSelf"
                  },
                  {
                    "message": "passkey is set exactly when type is Passkey",
                    "rule": "(self.type == 'Passkey') == has(self.passkey)"
                  },
                  {
                    "message": "external is set exactly when type is GitHub or Google",
                    "rule": "(self.type != 'Passkey') == has(self.external)"
                  }
                ]
              },
              "status": {
                "description": "What changes after enrolment. Written by Zeabur Identity only.",
                "nullable": true,
                "properties": {
                  "label": {
                    "description": "The label the user gave it last; takes the place of `spec.passkey.label`.",
                    "maxLength": 64,
                    "nullable": true,
                    "type": "string"
                  },
                  "lastUsedAt": {
                    "description": "When it last signed in, in Unix seconds. Updated at most once a minute.",
                    "format": "int64",
                    "minimum": 0.0,
                    "nullable": true,
                    "type": "integer"
                  },
                  "revision": {
                    "default": 0,
                    "description": "Bumped by every account change that must not race a removal (see\n`KubeCredentialStore::remove`).",
                    "format": "int64",
                    "minimum": 0.0,
                    "type": "integer"
                  }
                },
                "type": "object"
              }
            },
            "required": [
              "spec"
            ],
            "title": "Credential",
            "type": "object"
          }
        },
        "selectableFields": [
          {
            "jsonPath": ".spec.user"
          }
        ],
        "served": true,
        "storage": true,
        "subresources": {
          "status": {}
        }
      }
    ]
  }
}
