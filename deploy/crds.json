{
  "apiVersion": "v1",
  "items": [
    {
      "apiVersion": "apiextensions.k8s.io/v1",
      "kind": "CustomResourceDefinition",
      "metadata": {
        "name": "users.identity.zeabur.com"
      },
      "spec": {
        "group": "identity.zeabur.com",
        "names": {
          "categories": [
            "zeabur-identity"
          ],
          "kind": "User",
          "plural": "users",
          "shortNames": [
            "zbuser"
          ],
          "singular": "user"
        },
        "scope": "Namespaced",
        "versions": [
          {
            "additionalPrinterColumns": [
              {
                "jsonPath": ".spec.username",
                "name": "Username",
                "type": "string"
              },
              {
                "jsonPath": ".spec.accountType",
                "name": "Type",
                "type": "string"
              },
              {
                "jsonPath": ".spec.disabled",
                "name": "Disabled",
                "type": "boolean"
              },
              {
                "jsonPath": ".metadata.creationTimestamp",
                "name": "Age",
                "type": "date"
              }
            ],
            "name": "v1alpha1",
            "schema": {
              "openAPIV3Schema": {
                "description": "A person who can sign in to Zeabur Identity.",
                "properties": {
                  "spec": {
                    "description": "A person who can sign in. The admin (or GitOps) owns `spec`; Zeabur Identity only reads it.\n\nKubernetes sees the user as `zeabur:<username>` with groups `zeabur:<group>`, plus\n`zeabur:admins` for an admin account.",
                    "properties": {
                      "accountType": {
                        "default": "Regular",
                        "description": "`Admin` or `Regular` (the default). An admin account signs in only with a passkey, gets\nshorter sessions, and its tokens carry the group `zeabur:admins`, which is bound to\n`cluster-admin`.",
                        "enum": [
                          "Regular",
                          "Admin"
                        ],
                        "type": "string"
                      },
                      "disabled": {
                        "default": false,
                        "description": "A disabled user cannot sign in, and refresh tokens stop working at their next use.",
                        "type": "boolean"
                      },
                      "displayName": {
                        "description": "Name shown in the UI.",
                        "maxLength": 128,
                        "nullable": true,
                        "type": "string"
                      },
                      "groups": {
                        "description": "Groups. Kubernetes sees each as `zeabur:<group>`. The characters exclude ':', so a group\ncan never spell a reserved name. `admins` is refused: set `accountType: Admin` instead.",
                        "items": {
                          "maxLength": 128,
                          "minLength": 1,
                          "pattern": "^[a-z0-9]([-a-z0-9._/]{0,126}[a-z0-9])?$",
                          "type": "string"
                        },
                        "maxItems": 64,
                        "type": "array",
                        "x-kubernetes-validations": [
                          {
                            "message": "the admins group comes from accountType: Admin; remove it from groups",
                            "rule": "!self.exists(g, g == 'admins')"
                          }
                        ]
                      },
                      "username": {
                        "description": "Login name: a lowercase DNS subdomain of at most 63 characters. Kubernetes sees\n`zeabur:<username>`. The length limit keeps the username usable as the\n`identity.zeabur.com/user` label value on invitations, credentials and grants.\nUse the username as the object name so object-name uniqueness also prevents duplicate\nusernames. Immutable because RBAC bindings and audit logs refer to it.",
                        "maxLength": 63,
                        "minLength": 1,
                        "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*$",
                        "type": "string",
                        "x-kubernetes-validations": [
                          {
                            "message": "username is immutable",
                            "rule": "self == oldSelf"
                          }
                        ]
                      }
                    },
                    "required": [
                      "username"
                    ],
                    "type": "object"
                  }
                },
                "required": [
                  "spec"
                ],
                "title": "User",
                "type": "object"
              }
            },
            "selectableFields": [
              {
                "jsonPath": ".spec.username"
              }
            ],
            "served": true,
            "storage": true
          }
        ]
      }
    },
    {
      "apiVersion": "apiextensions.k8s.io/v1",
      "kind": "CustomResourceDefinition",
      "metadata": {
        "name": "credentials.identity.zeabur.com"
      },
      "spec": {
        "group": "identity.zeabur.com",
        "names": {
          "categories": [
            "zeabur-identity"
          ],
          "kind": "Credential",
          "plural": "credentials",
          "shortNames": [
            "zbcred"
          ],
          "singular": "credential"
        },
        "scope": "Namespaced",
        "versions": [
          {
            "additionalPrinterColumns": [
              {
                "jsonPath": ".spec.user",
                "name": "User",
                "type": "string"
              },
              {
                "jsonPath": ".metadata.creationTimestamp",
                "name": "Age",
                "type": "date"
              }
            ],
            "name": "v1alpha1",
            "schema": {
              "openAPIV3Schema": {
                "description": "A passkey or linked upstream identity of a Zeabur Identity user.",
                "properties": {
                  "spec": {
                    "description": "A way for a `User` to sign in.\n\nThe object name is derived from the credential's unique key (`c-` + hex SHA-256 of the\npasskey credential ID, or of the upstream issuer and subject), so creating a duplicate fails\nwith `409 AlreadyExists`. That is the uniqueness check WebAuthn Level 3 §7.1 asks for, and\nit holds across replicas. The spec is immutable; revoking is deleting. `status` holds what\nthe user may change (the label) and when the credential was last used.",
                    "oneOf": [
                      {
                        "required": [
                          "passkey"
                        ]
                      },
                      {
                        "required": [
                          "external"
                        ]
                      }
                    ],
                    "properties": {
                      "external": {
                        "description": "An account at an upstream provider, which any `UpstreamProvider` with its issuer signs in.",
                        "properties": {
                          "issuer": {
                            "description": "Upstream issuer.",
                            "maxLength": 256,
                            "minLength": 1,
                            "type": "string"
                          },
                          "subject": {
                            "description": "Upstream subject: the stable account ID, never an email address.",
                            "maxLength": 256,
                            "minLength": 1,
                            "type": "string"
                          }
                        },
                        "required": [
                          "issuer",
                          "subject"
                        ],
                        "type": "object"
                      },
                      "passkey": {
                        "description": "A WebAuthn discoverable credential.",
                        "properties": {
                          "aaguid": {
                            "description": "Authenticator model (AAGUID), when the authenticator reports one.",
                            "nullable": true,
                            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
                            "type": "string"
                          },
                          "backupEligible": {
                            "default": false,
                            "description": "Whether the credential may be synced to other devices (BE flag).",
                            "type": "boolean"
                          },
                          "credentialId": {
                            "description": "Credential ID, base64url.",
                            "maxLength": 1366,
                            "minLength": 1,
                            "pattern": "^[A-Za-z0-9_-]+$",
                            "type": "string"
                          },
                          "label": {
                            "description": "User-chosen label, for example \"MacBook\".",
                            "maxLength": 64,
                            "nullable": true,
                            "type": "string"
                          },
                          "record": {
                            "description": "The relying party's stored credential record, as serialized by the WebAuthn library\n(public key, algorithm, flags). Opaque to Kubernetes.",
                            "maxLength": 16384,
                            "minLength": 1,
                            "type": "string"
                          }
                        },
                        "required": [
                          "credentialId",
                          "record"
                        ],
                        "type": "object"
                      },
                      "user": {
                        "description": "Name of the `User` object.",
                        "maxLength": 253,
                        "minLength": 1,
                        "type": "string"
                      }
                    },
                    "required": [
                      "user"
                    ],
                    "type": "object",
                    "x-kubernetes-validations": [
                      {
                        "message": "credentials are immutable; delete and re-enrol instead",
                        "rule": "self == oldSelf"
                      }
                    ]
                  },
                  "status": {
                    "description": "What changes after enrolment. Written by Zeabur Identity only.",
                    "nullable": true,
                    "properties": {
                      "label": {
                        "description": "The label the user gave it last; takes the place of `spec.passkey.label`.",
                        "maxLength": 64,
                        "nullable": true,
                        "type": "string"
                      },
                      "lastUsedAt": {
                        "description": "When it last signed in, in Unix seconds. Updated at most once a minute.",
                        "format": "int64",
                        "minimum": 0.0,
                        "nullable": true,
                        "type": "integer"
                      },
                      "revision": {
                        "default": 0,
                        "description": "Bumped by every account change that must not race a removal (see\n`KubeCredentialStore::remove`).",
                        "format": "int64",
                        "minimum": 0.0,
                        "type": "integer"
                      }
                    },
                    "type": "object"
                  }
                },
                "required": [
                  "spec"
                ],
                "title": "Credential",
                "type": "object"
              }
            },
            "selectableFields": [
              {
                "jsonPath": ".spec.user"
              }
            ],
            "served": true,
            "storage": true,
            "subresources": {
              "status": {}
            }
          }
        ]
      }
    },
    {
      "apiVersion": "apiextensions.k8s.io/v1",
      "kind": "CustomResourceDefinition",
      "metadata": {
        "name": "oauthclients.identity.zeabur.com"
      },
      "spec": {
        "group": "identity.zeabur.com",
        "names": {
          "categories": [
            "zeabur-identity"
          ],
          "kind": "OAuthClient",
          "plural": "oauthclients",
          "shortNames": [
            "zbclient"
          ],
          "singular": "oauthclient"
        },
        "scope": "Namespaced",
        "versions": [
          {
            "additionalPrinterColumns": [
              {
                "jsonPath": ".spec.type",
                "name": "Type",
                "type": "string"
              },
              {
                "jsonPath": ".metadata.creationTimestamp",
                "name": "Age",
                "type": "date"
              }
            ],
            "name": "v1alpha1",
            "schema": {
              "openAPIV3Schema": {
                "description": "An OAuth 2.0 / OpenID Connect client registered with Zeabur Identity.",
                "properties": {
                  "spec": {
                    "description": "A registered OAuth 2.0 / OpenID Connect client. The object name is the `client_id`.\n\nAdmission rules reject redirect URIs that RFC 9700 §2.1 and OAuth 2.1 forbid, so a\nmistake in a GitOps repository fails at `kubectl apply`, not at login.",
                    "properties": {
                      "audiences": {
                        "description": "Audiences this client may request tokens for (RFC 8707 resource indicators), for example\nthe `audiences` entry of the cluster's AuthenticationConfiguration.",
                        "items": {
                          "maxLength": 256,
                          "minLength": 1,
                          "type": "string"
                        },
                        "maxItems": 16,
                        "type": "array"
                      },
                      "displayName": {
                        "description": "Name shown on the consent and login pages.",
                        "maxLength": 128,
                        "nullable": true,
                        "type": "string"
                      },
                      "homeUrl": {
                        "description": "Where people open this application, for example `https://zeabur.example.com/`. When set,\nthe sign-in page links here, labelled with the display name, for anyone who reaches it with\nnothing to sign in to, and after someone sets up a passkey.",
                        "maxLength": 2048,
                        "nullable": true,
                        "type": "string",
                        "x-kubernetes-validations": [
                          {
                            "message": "the home URL must be https:// with a host; printable ASCII, no user information",
                            "rule": "self.matches('^[!-~]+$') && isURL(self) && !self.matches('^[^/]*//[^/?]*@') && url(self).getScheme() == 'https' && url(self).getHostname() != ''"
                          }
                        ]
                      },
                      "idTokenSigningAlg": {
                        "description": "A JWS signing algorithm this issuer uses.\n\nkube-apiserver accepts only the RS, ES and PS families ([kube-apiserver OIDC]), so EdDSA is\nnot offered. ES256 is the default for every token: smaller tokens and faster signing than\nRS256, and [RFC 7518] §3.1 marks it \"Recommended+\". RS256 exists only because\n[OIDC Discovery] §3 requires it in `id_token_signing_alg_values_supported`.\n\n[kube-apiserver OIDC]: https://github.com/kubernetes/kubernetes/blob/master/staging/src/k8s.io/apiserver/plugin/pkg/authenticator/token/oidc/oidc.go\n[RFC 7518]: https://www.rfc-editor.org/rfc/rfc7518\n[OIDC Discovery]: https://openid.net/specs/openid-connect-discovery-1_0.html",
                        "enum": [
                          "ES256",
                          "RS256"
                        ],
                        "nullable": true,
                        "type": "string"
                      },
                      "redirectUris": {
                        "description": "Redirect URIs, compared by exact string match. Each is `https://` with a host, or\n`http://127.0.0.1` / `http://[::1]` with a path for native apps (RFC 8252 §7.3); ASCII URI\ncharacters only, no fragment.",
                        "items": {
                          "maxLength": 2048,
                          "type": "string"
                        },
                        "maxItems": 16,
                        "minItems": 1,
                        "type": "array",
                        "x-kubernetes-validations": [
                          {
                            "message": "each redirect URI must be https:// with a host, or http://127.0.0.1 or http://[::1] with a path; printable ASCII, no fragment or user information",
                            "rule": "self.all(u, u.matches('^[!-~]+$') && !u.contains('#') && isURL(u) && !u.matches('^[^/]*//[^/?]*@') && (url(u).getScheme() == 'https' ? url(u).getHostname() != '' : url(u).getScheme() == 'http' && url(u).getHostname() in ['127.0.0.1', '::1'] && url(u).getEscapedPath() != ''))"
                          }
                        ]
                      },
                      "secretHash": {
                        "description": "SHA-256 of the client secret, as `sha256:<64 hex digits>`. The secret itself is never\nstored.",
                        "nullable": true,
                        "pattern": "^sha256:[0-9a-f]{64}$",
                        "type": "string"
                      },
                      "type": {
                        "description": "Public clients (kubectl, native apps) cannot keep a secret; confidential clients can.",
                        "enum": [
                          "Public",
                          "Confidential"
                        ],
                        "type": "string"
                      }
                    },
                    "required": [
                      "redirectUris",
                      "type"
                    ],
                    "type": "object",
                    "x-kubernetes-validations": [
                      {
                        "message": "secretHash is required for confidential clients and forbidden for public clients",
                        "rule": "(self.type == 'Confidential') == has(self.secretHash)"
                      }
                    ]
                  }
                },
                "required": [
                  "spec"
                ],
                "title": "OAuthClient",
                "type": "object"
              }
            },
            "served": true,
            "storage": true
          }
        ]
      }
    },
    {
      "apiVersion": "apiextensions.k8s.io/v1",
      "kind": "CustomResourceDefinition",
      "metadata": {
        "name": "grants.identity.zeabur.com"
      },
      "spec": {
        "group": "identity.zeabur.com",
        "names": {
          "categories": [
            "zeabur-identity"
          ],
          "kind": "Grant",
          "plural": "grants",
          "shortNames": [
            "zbgrant"
          ],
          "singular": "grant"
        },
        "scope": "Namespaced",
        "versions": [
          {
            "additionalPrinterColumns": [
              {
                "jsonPath": ".spec.user",
                "name": "User",
                "type": "string"
              },
              {
                "jsonPath": ".spec.client",
                "name": "Client",
                "type": "string"
              },
              {
                "jsonPath": ".status.rotation",
                "name": "Rotations",
                "type": "integer"
              },
              {
                "jsonPath": ".metadata.creationTimestamp",
                "name": "Age",
                "type": "date"
              }
            ],
            "name": "v1alpha1",
            "schema": {
              "openAPIV3Schema": {
                "description": "A refresh-token family issued by Zeabur Identity.",
                "properties": {
                  "spec": {
                    "description": "One login's refresh-token family.\n\nCreated when an authorization code is redeemed; every refresh rotates the token with one\ncompare-and-swap on `status`; reuse of an old token deletes the object, which revokes the\nwhole family. Deleting it by hand is how an admin revokes a session\n(`kubectl delete grant`, or `-l identity.zeabur.com/user=<user>` for all of a user's).\nOnly hashes are stored.\n\nSigning in to the account page creates one too: named `s-…`, with client `zeabur_identity`\n(never a valid `OAuthClient` name), and no refresh token.",
                    "properties": {
                      "amr": {
                        "description": "Authentication methods (RFC 8176 values).",
                        "items": {
                          "maxLength": 32,
                          "minLength": 1,
                          "type": "string"
                        },
                        "maxItems": 8,
                        "type": "array"
                      },
                      "audience": {
                        "description": "Audience of the tokens issued from this grant.",
                        "maxLength": 256,
                        "minLength": 1,
                        "type": "string"
                      },
                      "authTime": {
                        "description": "When the user authenticated, in Unix seconds (OIDC `auth_time`).",
                        "format": "int64",
                        "minimum": 0.0,
                        "type": "integer"
                      },
                      "client": {
                        "description": "Name of the `OAuthClient` object (the `client_id`).",
                        "maxLength": 253,
                        "minLength": 1,
                        "type": "string"
                      },
                      "credential": {
                        "description": "Name of the `Credential` the user signed in with. Removing that credential revokes the\ngrant.",
                        "maxLength": 253,
                        "minLength": 1,
                        "nullable": true,
                        "type": "string"
                      },
                      "deviceBound": {
                        "description": "Whether the user signed in with a device-bound passkey (BE unset).",
                        "type": "boolean"
                      },
                      "expiresAt": {
                        "description": "Absolute expiry, in Unix seconds. The family cannot be refreshed after this.",
                        "format": "int64",
                        "minimum": 0.0,
                        "type": "integer"
                      },
                      "initialHash": {
                        "description": "`sha256:<hex>` of the first refresh token. Valid until the first rotation writes `status`,\nso creating a family is one write.",
                        "pattern": "^sha256:[0-9a-f]{64}$",
                        "type": "string"
                      },
                      "initialIdleExpiresAt": {
                        "description": "Idle expiry until the first rotation writes `status`, in Unix seconds.",
                        "format": "int64",
                        "minimum": 0.0,
                        "type": "integer"
                      },
                      "scopes": {
                        "description": "Granted scopes.",
                        "items": {
                          "maxLength": 64,
                          "minLength": 1,
                          "type": "string"
                        },
                        "maxItems": 16,
                        "type": "array"
                      },
                      "subject": {
                        "description": "UID of the `User` at sign-in.",
                        "maxLength": 128,
                        "minLength": 1,
                        "nullable": true,
                        "type": "string"
                      },
                      "user": {
                        "description": "Name of the `User` object.",
                        "maxLength": 253,
                        "minLength": 1,
                        "type": "string"
                      },
                      "userVerified": {
                        "description": "Whether the authenticator verified the user at sign-in.",
                        "type": "boolean"
                      }
                    },
                    "required": [
                      "audience",
                      "authTime",
                      "client",
                      "expiresAt",
                      "initialHash",
                      "initialIdleExpiresAt",
                      "user"
                    ],
                    "type": "object",
                    "x-kubernetes-validations": [
                      {
                        "message": "a grant's spec is immutable",
                        "rule": "self == oldSelf"
                      }
                    ]
                  },
                  "status": {
                    "description": "Rotation state, changed only through compare-and-swap.",
                    "nullable": true,
                    "properties": {
                      "currentHash": {
                        "description": "`sha256:<hex>` of the refresh token that is currently valid.",
                        "pattern": "^sha256:[0-9a-f]{64}$",
                        "type": "string"
                      },
                      "idleExpiresAt": {
                        "default": 0,
                        "description": "Idle expiry, in Unix seconds; pushed forward by each rotation.",
                        "format": "int64",
                        "minimum": 0.0,
                        "type": "integer"
                      },
                      "previousHash": {
                        "description": "`sha256:<hex>` of the previous token, kept to tell a replay from a forgery.",
                        "nullable": true,
                        "pattern": "^sha256:[0-9a-f]{64}$",
                        "type": "string"
                      },
                      "reauth": {
                        "description": "The latest re-authentication, for account sessions.",
                        "nullable": true,
                        "properties": {
                          "authTime": {
                            "description": "When, in Unix seconds.",
                            "format": "int64",
                            "minimum": 0.0,
                            "type": "integer"
                          },
                          "credential": {
                            "description": "Name of the `Credential` used.",
                            "maxLength": 253,
                            "minLength": 1,
                            "nullable": true,
                            "type": "string"
                          },
                          "userVerified": {
                            "default": false,
                            "description": "Whether the authenticator verified the user.",
                            "type": "boolean"
                          }
                        },
                        "required": [
                          "authTime"
                        ],
                        "type": "object"
                      },
                      "rotation": {
                        "default": 0,
                        "description": "Number of rotations so far.",
                        "format": "int64",
                        "minimum": 0.0,
                        "type": "integer"
                      }
                    },
                    "required": [
                      "currentHash"
                    ],
                    "type": "object"
                  }
                },
                "required": [
                  "spec"
                ],
                "title": "Grant",
                "type": "object"
              }
            },
            "selectableFields": [
              {
                "jsonPath": ".spec.user"
              }
            ],
            "served": true,
            "storage": true,
            "subresources": {
              "status": {}
            }
          }
        ]
      }
    },
    {
      "apiVersion": "apiextensions.k8s.io/v1",
      "kind": "CustomResourceDefinition",
      "metadata": {
        "name": "invitations.identity.zeabur.com"
      },
      "spec": {
        "group": "identity.zeabur.com",
        "names": {
          "categories": [
            "zeabur-identity"
          ],
          "kind": "Invitation",
          "plural": "invitations",
          "shortNames": [
            "zbinvite"
          ],
          "singular": "invitation"
        },
        "scope": "Namespaced",
        "versions": [
          {
            "additionalPrinterColumns": [
              {
                "jsonPath": ".spec.user",
                "name": "User",
                "type": "string"
              },
              {
                "jsonPath": ".metadata.creationTimestamp",
                "name": "Age",
                "type": "date"
              }
            ],
            "name": "v1alpha1",
            "schema": {
              "openAPIV3Schema": {
                "description": "A one-time passkey enrolment link for a Zeabur Identity user.",
                "properties": {
                  "spec": {
                    "description": "A one-time enrolment link for a `User`, created by an admin (`zeabur-identityctl invite`).\n\nThe link carries `<invitation name>.<secret>`; only the SHA-256 of that token is stored. It\nworks once: redeeming deletes the object with UID and resourceVersion preconditions before\nthe passkey is stored, so exactly one of any number of concurrent redemptions succeeds. The\nadmin's CLI generates the token, records its hash in `spec` and prints the link; delivering it\nis up to the admin. Expired invitations are deleted by the garbage collector.",
                    "properties": {
                      "expiresAt": {
                        "description": "When the link stops working, in Unix seconds.",
                        "format": "int64",
                        "minimum": 0.0,
                        "type": "integer"
                      },
                      "tokenHash": {
                        "description": "`sha256:<hex>` of the token in the link.",
                        "pattern": "^sha256:[0-9a-f]{64}$",
                        "type": "string"
                      },
                      "user": {
                        "description": "Name of the `User` object the invitation enrols a passkey for.",
                        "maxLength": 253,
                        "minLength": 1,
                        "type": "string"
                      }
                    },
                    "required": [
                      "expiresAt",
                      "tokenHash",
                      "user"
                    ],
                    "type": "object",
                    "x-kubernetes-validations": [
                      {
                        "message": "an invitation's spec is immutable",
                        "rule": "self == oldSelf"
                      }
                    ]
                  }
                },
                "required": [
                  "spec"
                ],
                "title": "Invitation",
                "type": "object"
              }
            },
