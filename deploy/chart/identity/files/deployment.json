{
  "apiVersion": "v1",
  "kind": "List",
  "items": [
    {
      "apiVersion": "v1",
      "kind": "Service",
      "metadata": {
        "labels": {
          "app.kubernetes.io/managed-by": "zeabur-identity",
          "app.kubernetes.io/name": "zeabur-identity"
        },
        "name": "zeabur-identity",
        "namespace": "zeabur-identity"
      },
      "spec": {
        "ports": [
          {
            "name": "http",
            "port": 80,
            "protocol": "TCP",
            "targetPort": "http"
          },
          {
            "name": "internal",
            "port": 443,
            "protocol": "TCP",
            "targetPort": "internal"
          }
        ],
        "selector": {
          "app.kubernetes.io/name": "zeabur-identity"
        },
        "type": "ClusterIP"
      }
    },
    {
      "apiVersion": "apps/v1",
      "kind": "Deployment",
      "metadata": {
        "labels": {
          "app.kubernetes.io/managed-by": "zeabur-identity",
          "app.kubernetes.io/name": "zeabur-identity"
        },
        "name": "zeabur-identity",
        "namespace": "zeabur-identity"
      },
      "spec": {
        "replicas": 1,
        "selector": {
          "matchLabels": {
            "app.kubernetes.io/name": "zeabur-identity"
          }
        },
        "strategy": {
          "type": "Recreate"
        },
        "template": {
          "metadata": {
            "labels": {
              "app.kubernetes.io/managed-by": "zeabur-identity",
              "app.kubernetes.io/name": "zeabur-identity"
            }
          },
          "spec": {
            "containers": [
              {
                "env": [
                  {
                    "name": "ZEABUR_IDENTITY_ISSUER",
                    "value": "https://identity.example.com"
                  },
                  {
                    "name": "ZEABUR_IDENTITY_NAMESPACE",
                    "valueFrom": {
                      "fieldRef": {
                        "fieldPath": "metadata.namespace"
                      }
                    }
                  }
                ],
                "image": "",
                "livenessProbe": {
                  "httpGet": {
                    "path": "/healthz",
                    "port": "http"
                  },
                  "periodSeconds": 10
                },
                "name": "zeabur-identity",
                "ports": [
                  {
                    "containerPort": 8080,
                    "name": "http",
                    "protocol": "TCP"
                  },
                  {
                    "containerPort": 8443,
                    "name": "internal",
                    "protocol": "TCP"
                  }
                ],
                "readinessProbe": {
                  "httpGet": {
                    "path": "/readyz",
                    "port": "http"
                  },
                  "periodSeconds": 10
                },
                "resources": {
                  "limits": {
                    "memory": "128Mi"
                  },
                  "requests": {
                    "cpu": "10m",
                    "memory": "24Mi"
                  }
                },
                "securityContext": {
                  "allowPrivilegeEscalation": false,
                  "capabilities": {
                    "drop": [
                      "ALL"
                    ]
                  },
                  "readOnlyRootFilesystem": true,
                  "runAsNonRoot": true
                },
                "startupProbe": {
                  "failureThreshold": 12,
                  "httpGet": {
                    "path": "/healthz",
                    "port": "http"
                  },
                  "periodSeconds": 10
                }
              }
            ],
            "securityContext": {
              "fsGroup": 65532,
              "runAsGroup": 65532,
              "runAsNonRoot": true,
              "runAsUser": 65532,
              "seccompProfile": {
                "type": "RuntimeDefault"
              }
            },
            "serviceAccountName": "zeabur-identity"
          }
        }
      }
    }
  ]
}
